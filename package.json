{
  "name": "uletodo",
  "version": "1.0.0",
  "description": "A modern, cross-platform desktop todo application built with Tauri + TypeScript + React + Rust.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest --run src/test/integration",
    "test:performance": "vitest --run src/test/performance",
    "test:unit": "vitest --run src/**/*.test.{ts,tsx}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://yeuleh@github.com/yeuleh/uletodo.git"
  },
